# App
NODE_ENV=development
PORT=3000
APP_NAME=ExamSetu Nepal
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite database
DATABASE_URL=file:./data/examsetu.db

# Next.js production database and authentication
# DATABASE_URL=postgresql://user:password@localhost:5432/examsetu
AUTH_SECRET=replace_with_at_least_32_random_characters
SEED_ADMIN_NAME=ExamSetu Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Object storage (R2/S3/Supabase adapter to be configured)
STORAGE_PROVIDER=unconfigured
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Login session security
SESSION_NAME=examsetu_sid
SESSION_SECRET=your_long_random_secret_here

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_NAME=ExamSetu Admin

# Google AdSense
GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Contact
CONTACT_EMAIL=contact@example.com

# Telegram Quiz Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Guru AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
